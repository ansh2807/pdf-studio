# Copy this file to ".env" and edit it before running docker compose.

# Your domain. A DNS "A" record for it must point to this server's public IP.
# Caddy will get a free HTTPS certificate automatically for a real domain.
#   SITE_ADDRESS=pdf.example.com
# To test without a domain yet (plain HTTP on port 80), use:
#   SITE_ADDRESS=:80
SITE_ADDRESS=pdf.example.com

# Max upload size in MB (per file).
MAX_UPLOAD_MB=100
